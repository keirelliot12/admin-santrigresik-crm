# -----------------------------------------------------------------------
# admin-santrigresik-crm — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# -----------------------------------------------------------------------

# NextAuth.js — required
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret

# Full public URL of this admin app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------
# SaaS backend (binkhozin/santrigresik-saas)
# -----------------------------------------------------------------------

# Base URL for all API calls to the SaaS backend (no trailing slash).
# Example: https://api.santrigresik.id
NEXT_PUBLIC_SAAS_API_URL=http://localhost:4000

# -----------------------------------------------------------------------
# Local Prisma (session storage only — do not use for business data)
# -----------------------------------------------------------------------
# The DATABASE_URL below is only used by NextAuth session/account tables.
# All business data (clients, subscriptions, invoices, etc.) must come
# from NEXT_PUBLIC_SAAS_API_URL, not from this local database.
DATABASE_URL=file:./prisma/dev.db
